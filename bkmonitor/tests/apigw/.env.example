# APIGW 自动化测试环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 蓝鲸应用认证信息（根据环境使用不同后缀）
# PAAS3 环境
BK_APP_CODE_PAAS3=your_app_code_here
BK_APP_SECRET_PAAS3=your_app_secret_here

# OP 环境
BK_APP_CODE_OP=your_app_code_here
BK_APP_SECRET_OP=your_app_secret_here

# PROD 环境
BK_APP_CODE_PROD=your_app_code_here
BK_APP_SECRET_PROD=your_app_secret_here
